        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(suggestionId) &&
        isValidSuggestion(incoming()) &&
        incoming().id == existing().id &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
    }

    match /leaderApplications/{applicationId} {
      allow get: if isValidId(applicationId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(applicationId) &&
        isValidLeaderApplication(incoming()) &&
        incoming().id == applicationId &&
        incoming().uid == request.auth.uid &&
        incoming().status == 'pending' &&
