    match /communitySuggestions/{suggestionId} {
      allow get: if isValidId(suggestionId) && (isOwner(existing().uid) || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(suggestionId) &&
