      allow create: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidPost(incoming()) &&
        incoming().id == postId &&
        incoming().authorId == request.auth.uid &&
        incoming().status == 'published' &&
        incoming().isPinned == false &&
        incoming().likesCount == 0 &&
        incoming().commentsCount == 0 &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/communities/$(incoming().communityId));
      allow update: if isVerifiedUser() &&
        isValidId(postId) &&
        isValidPost(incoming()) &&
        incoming().id == existing().id &&
        incoming().communityId == existing().communityId &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            isOwner(existing().authorId) &&
            existing().status == 'published' &&
            incoming().status == existing().status &&
            incoming().isPinned == existing().isPinned &&
            incoming().likesCount == existing().likesCount &&
            incoming().commentsCount == existing().commentsCount &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'category', 'tags', 'updatedAt'])
          ) || (
            existing().status == 'published' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'updatedAt']) &&
            incoming().likesCount >= existing().likesCount - 1 &&
            incoming().likesCount <= existing().likesCount + 1 &&
            incoming().commentsCount >= existing().commentsCount &&
            incoming().commentsCount <= existing().commentsCount + 1
          )
        );
      allow delete: if isVerifiedUser() &&
        isValidId(postId) &&
        (isOwner(existing().authorId) || isAdmin());

      match /comments/{commentId} {
        allow get: if isValidId(postId) &&
          isValidId(commentId) &&
          (existing().status == 'published' || isOwner(existing().authorId) || isAdmin());
        allow list: if resource.data.status == 'published' ||
          (isSignedIn() && resource.data.authorId == request.auth.uid) ||
          isAdmin();
        allow create: if isVerifiedUser() &&
          isValidId(postId) &&
          isValidId(commentId) &&
          isValidComment(incoming()) &&
          incoming().id == commentId &&
          incoming().postId == postId &&
          incoming().authorId == request.auth.uid &&
          incoming().status == 'published' &&
          incoming().likesCount == 0 &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/posts/$(postId));
        allow update: if isVerifiedUser() &&
          isValidId(postId) &&
          isValidId(commentId) &&
          isValidComment(incoming()) &&
          incoming().id == existing().id &&
          incoming().postId == existing().postId &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isAdmin() || (
              isOwner(existing().authorId) &&
              existing().status == 'published' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])
            )
          );
        allow delete: if isVerifiedUser() &&
          isValidId(postId) &&
          isValidId(commentId) &&
          (isOwner(existing().authorId) || isAdmin());
      }

      match /likes/{uid} {
        allow get: if isValidId(postId) && isValidId(uid);
        allow list: if isValidId(postId) && resource.data.postId == postId;
        allow create: if isVerifiedUser() &&
          isValidId(postId) &&
          isValidId(uid) &&
          isOwner(uid) &&
          isValidPostLike(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().postId == postId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/posts/$(postId));
        allow delete: if isVerifiedUser() &&
          isValidId(postId) &&
          isValidId(uid) &&
          (isOwner(uid) || isAdmin());
      }
    }

    match /challenges/{challengeId} {
      allow get: if isValidId(challengeId) && (existing().status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create: if isAdmin() &&
        isValidId(challengeId) &&
