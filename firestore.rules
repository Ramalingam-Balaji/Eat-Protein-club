    }

    match /events/{eventId} {
      allow get: if isValidId(eventId) && (existing().status == 'upcoming' || isAdmin());
      allow list: if resource.data.status == 'upcoming' || isAdmin();
      allow create: if isAdmin() &&
        isValidId(eventId) &&
        isValidClubEvent(incoming()) &&
        incoming().id == eventId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(eventId) &&
        isValidClubEvent(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            incoming().diff(existing()).affectedKeys().hasOnly(['rsvpCount', 'updatedAt']) &&
            incoming().rsvpCount >= existing().rsvpCount - 1 &&
            incoming().rsvpCount <= existing().rsvpCount + 1
          )
        );
      allow delete: if isAdmin() && isValidId(eventId);

      match /rsvps/{uid} {
        allow get: if isValidId(eventId) && isValidId(uid) && (isOwner(uid) || isAdmin());
        allow list: if isValidId(eventId) && isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
        allow create: if isVerifiedUser() &&
          isValidId(eventId) &&
          isValidId(uid) &&
          isOwner(uid) &&
          isValidEventRsvp(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().eventId == eventId &&
          incoming().createdAt == request.time &&
          exists(/databases/$(database)/documents/events/$(eventId));
        allow delete: if isVerifiedUser() && isValidId(eventId) && isValidId(uid) && (isOwner(uid) || isAdmin());
      }
    }
  }
