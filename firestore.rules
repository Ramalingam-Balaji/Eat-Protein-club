          isAdmin() || (
            incoming().diff(existing()).affectedKeys().hasOnly(['participantsCount', 'updatedAt']) &&
            incoming().participantsCount >= existing().participantsCount &&
            incoming().participantsCount <= existing().participantsCount + 1
          )
        );
      allow delete: if isAdmin() && isValidId(challengeId);

      match /participants/{uid} {
        allow get: if isValidId(challengeId) &&
          isValidId(uid) &&
          (isOwner(uid) || isAdmin() || existing().streak >= 0);
        allow list: if isValidId(challengeId) && resource.data.challengeId == challengeId;
        allow create: if isVerifiedUser() &&
          isValidId(challengeId) &&
          isValidId(uid) &&
          isOwner(uid) &&
          isValidChallengeParticipant(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().challengeId == challengeId &&
          incoming().joinedAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/challenges/$(challengeId));
        allow update: if isVerifiedUser() &&
          isValidId(challengeId) &&
          isValidId(uid) &&
          isValidChallengeParticipant(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().challengeId == existing().challengeId &&
          incoming().joinedAt == existing().joinedAt &&
          incoming().updatedAt == request.time && (
            isAdmin() || (
              isOwner(uid) &&
              existing().status != 'completed' &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'currentDay', 'completedDays', 'streak',
                'pointsEarned', 'coinsEarned', 'status', 'updatedAt'
              ])
            )
          );
      }
    }

    match /rewards/{rewardId} {
      allow get: if isValidId(rewardId) && (existing().status == 'active' || isAdmin());
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create: if isAdmin() &&
