      allow delete: if isAdmin() && isValidId(communityId);

      match /members/{memberId} {
        allow get: if isValidId(communityId) &&
          isValidId(memberId) &&
          (existing().status == 'active' || isOwner(memberId) || isAdmin());
        allow list: if resource.data.status == 'active' ||
          (isSignedIn() && resource.data.uid == request.auth.uid) ||
          isAdmin();
        allow create: if isVerifiedUser() &&
          isValidId(communityId) &&
          isValidId(memberId) &&
          isOwner(memberId) &&
          isValidCommunityMember(incoming()) &&
          incoming().uid == request.auth.uid &&
          incoming().communityId == communityId &&
          incoming().role == 'member' &&
          incoming().status == 'active' &&
          incoming().joinedAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/communities/$(communityId));
        allow update: if isAdmin() &&
          isValidId(communityId) &&
          isValidId(memberId) &&
          isValidCommunityMember(incoming()) &&
          incoming().uid == existing().uid &&
          incoming().communityId == existing().communityId &&
          incoming().joinedAt == existing().joinedAt &&
          incoming().updatedAt == request.time;
        allow delete: if isVerifiedUser() &&
          isValidId(communityId) &&
          isValidId(memberId) &&
